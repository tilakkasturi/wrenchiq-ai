# WrenchIQ — Environment Configuration
# Copy to .env.local and fill in your values before starting the server.

# ── Generic LLM endpoint (OpenAI-compatible — takes priority over Anthropic/Azure) ──
# Set to any OpenAI-compatible server. Leave LLM_API_KEY blank for local servers.
# Example (local):  LLM_BASE_URL=http://192.222.55.177:8081/v1
# Example (Azure):  LLM_BASE_URL=https://prediillm2.openai.azure.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Which client the LLM gateway uses underneath: langchain (default) or legacy.
# Both build the same request and return the same response — 'legacy' restores
# the original raw-fetch implementation as a no-rebuild rollback (AE-1286).
# Leave unset unless you are rolling back.
LLM_ENGINE=

# Browser-side LLM (for ing entity extraction — must be CORS-accessible)
VITE_LLM_BASE_URL=
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gpt-4o-mini

# ── RO Chat "Frontier model" tier (V5 feedback D3) ───────────────────────────
# A genuinely separate deployment (e.g. a shop's own Azure Foundry GPT-5.5
# resource) — its own base URL/key/model, NOT reused from LLM_BASE_URL above.
# Only wired into RO Chat's frontier-model toggle; leave unset to keep the
# toggle disabled (it falls back to Predii LLM with a clear notice, rather
# than silently resending the same model to the wrong endpoint).
# Example: AZURE_OPENAI_FRONTIER_BASE_URL=https://prediillm2.services.ai.azure.com/openai/v1
AZURE_OPENAI_FRONTIER_BASE_URL=
AZURE_OPENAI_FRONTIER_API_KEY=
AZURE_OPENAI_FRONTIER_MODEL=gpt-5.5
# AZURE_OPENAI_FRONTIER_API_VERSION=2024-12-01-preview

# RO Chat completion-token budget (server/config.js RO_CHAT_MAX_TOKENS).
# Reasoning models (gpt-5.x) spend part of this on hidden reasoning before
# writing a visible reply, so complex prompts need more headroom than the
# 500 that's plenty for a simple rewrite. The Tauri chat UI can override
# this per-request for complex tasks (clamped server-side).
LLM_MAX_TOKENS=2000

# ── Claude / Anthropic ────────────────────────────────────────────────────────
# Your Anthropic API key (fallback when LLM_BASE_URL is not set)
ANTHROPIC_API_KEY=sk-ant-...

# Claude API endpoint — override only if using a proxy or private deployment
# CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# Anthropic API version header
# CLAUDE_API_VERSION=2023-06-01

# Model for Knowledge Graph chat (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL_CHAT=claude-haiku-4-5-20251001

# Model for Recommendations engine (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL_RECOMMENDATIONS=claude-haiku-4-5-20251001

# Token budget overrides (optional)
# CLAUDE_MAX_TOKENS_CHAT=800
# CLAUDE_MAX_TOKENS_RECOMMENDATIONS=3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Connection string — local or Atlas
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DB=wrenchiq

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=3001

# ── Predii Learn (ro-ner-demo) ─────────────────────────────────────────────────
# Base URL of the ro-ner-demo FastAPI service — assumed already running separately.
RO_NER_BASE_URL=http://localhost:8090

# Vite exposes this to the browser build
VITE_API_BASE=http://localhost:3001

# Origin where Surface A (the web admin app) is reachable — used by the Tauri
# Sidecar's settings gear icon to open /admin.html in the OS browser, since the
# desktop shell has no other concept of the web app's root.
VITE_WEB_APP_BASE_URL=http://localhost:5173

# Anthropic API key exposed to browser (for 3C Story Writer client-side calls)
VITE_ANTHROPIC_API_KEY=sk-ant-...
