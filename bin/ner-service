#!/usr/bin/env bash
# bin/ner-service — Start the ro-ner-demo FastAPI service (Predii Learn's
# backend) on port 8090, the address server/config.js's RO_NER_BASE_URL
# defaults to (see server/routes/prediiLearn.js).
#
# Shares next-gen's .env.local so it points at the same Mongo/LLM endpoints
# (ner_server.py reads MONGODB_URI, MONGODB_DB, LLM_BASE_URL, LLM_MODEL from
# env, overriding ner_config.yaml — see the comment at the top of that file).
#
# Run from any directory; always cds into ro-ner-demo/ first because
# ner_server.py opens ner_config.yaml relative to cwd, not __file__.

set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -f .env.local ]]; then
  set -a
  source .env.local
  set +a
fi

# ner_symptom_cache.py uses PEP 604 union syntax (`X | None`) in a module-level
# annotation, which only Python 3.10+ evaluates without raising — a plain `python3`
# can silently resolve to an older interpreter (e.g. macOS's system Python 3.9)
# depending on shell/PATH setup, so prefer a known-good 3.10+ interpreter when one
# is available rather than trusting whatever's first on PATH.
PYTHON=python3
if [[ -x /opt/predii/anaconda3/bin/python3 ]]; then
  PYTHON=/opt/predii/anaconda3/bin/python3
fi

cd ro-ner-demo
exec "$PYTHON" ner_server.py
