#!/usr/bin/env bash
# bin/stop-demo — Stop the WrenchIQ demo (ro-ner-demo + backend + Tauri
# Sidecar app)
#
# Usage:
#   bin/stop-demo

set -euo pipefail
cd "$(dirname "$0")"

./tauri-app stop

# Only kill a ner_server.py whose cwd is *this repo's* ro-ner-demo/ — never a
# same-named process running elsewhere (e.g. the standalone /opt/predii/
# ro-ner-demo instance other tools may depend on).
repo_ro_ner_dir="$(cd .. && pwd)/ro-ner-demo"
killed=0
for pid in $(pgrep -f "ner_server.py" 2>/dev/null || true); do
  cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' || true)
  if [[ "$cwd" == "$repo_ro_ner_dir" ]]; then
    kill "$pid" 2>/dev/null && killed=$((killed + 1))
  fi
done
echo "ro-ner-demo: $killed process(es) stopped."
