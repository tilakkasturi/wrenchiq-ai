{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WrenchIQ",
  "version": "0.1.0",
  "identifier": "ai.wrenchiq.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:full",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "WrenchIQ Intelligence",
        "url": "sidecar.html",
        "width": 420,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
